---
import Base from '../../layouts/Base.astro';
import Breadcrumb from '../../components/Breadcrumb.astro';
import { categories } from '../../data/site';
import { tools } from '../../lib/registry';

const description =
  'Browse text cleaning tools by category: cleaning, sorting, case conversion, whitespace, invisible characters, extraction and text diffing.';
---

<Base title="Tool Categories — ScrubKit" description={description}>
  <div class="container-page pt-8">
    <Breadcrumb items={[{ label: 'Home', href: '/' }, { label: 'Categories' }]} />

    <header class="mt-6 max-w-3xl">
      <span class="eyebrow text-ink-3">Browse</span>
      <h1 class="mt-3 text-4xl font-extrabold sm:text-5xl">Categories</h1>
      <p class="mt-3 text-lg text-ink-2">
        Grouped by the kind of mess they fix. Each hub lists its tools with
        everything running in your browser.
      </p>
    </header>

    <div class="mt-10 grid gap-5 sm:grid-cols-2 lg:grid-cols-3">
      {
        categories.map((category) => {
          const count = tools.filter((tool) => tool.category === category.slug).length;
          return (
            <a href={`/categories/${category.slug}/`} class="card block h-full p-6">
              <div class="flex items-start justify-between gap-3">
                <h2 class="text-lg font-bold">{category.name}</h2>
                <span class="chip shrink-0">
                  {count} {count === 1 ? 'tool' : 'tools'}
                </span>
              </div>
              <p class="mt-2 text-sm leading-relaxed text-ink-2">{category.blurb}</p>
            </a>
          );
        })
      }
    </div>
  </div>
</Base>
