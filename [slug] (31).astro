---
import Base from '../../layouts/Base.astro';
import Breadcrumb from '../../components/Breadcrumb.astro';
import ToolCard from '../../components/ToolCard.astro';
import { getTool } from '../../lib/registry';
import { guides } from '../../data/site';
import type { ToolDefinition } from '../../lib/types';
import type { GuideDef } from '../../data/site';

export function getStaticPaths() {
  return guides.map((guide) => ({
    params: { slug: guide.slug },
    props: { guide },
  }));
}

interface Props {
  guide: GuideDef;
}

const { guide } = Astro.props;
const linkedTools = guide.tools
  .map((slug) => getTool(slug))
  .filter((entry): entry is ToolDefinition => Boolean(entry));
const otherGuides = guides.filter((entry) => entry.slug !== guide.slug);
const description = `${guide.lede}`.slice(0, 155);
---

<Base title={`${guide.title} | ScrubKit`} description={description}>
  <div class="container-page pt-8">
    <Breadcrumb
      items={[
        { label: 'Home', href: '/' },
        { label: 'Guides', href: '/guides/' },
        { label: guide.title },
      ]}
    />

    <header class="mt-6 max-w-3xl">
      <span class="eyebrow text-ink-3">Guide</span>
      <h1 class="mt-3 text-4xl font-extrabold sm:text-5xl">{guide.title}</h1>
      <p class="mt-3 text-lg text-ink-2">{guide.lede}</p>
    </header>

    <div class="mt-12 grid gap-12 lg:grid-cols-3">
      <article class="prose-page lg:col-span-2">
        {
          guide.sections.map((section) => (
            <section>
              <h2>{section.heading}</h2>
              {section.paragraphs.map((paragraph) => (
                <p>{paragraph}</p>
              ))}
            </section>
          ))
        }
      </article>

      <aside>
        <h2 class="text-xs font-bold uppercase tracking-widest text-ink-3">Tools mentioned</h2>
        <div class="mt-4 space-y-4">
          {
            linkedTools.map((tool) => (
              <ToolCard slug={tool.slug} title={tool.title} tagline={tool.tagline} />
            ))
          }
        </div>

        <h2 class="mt-10 text-xs font-bold uppercase tracking-widest text-ink-3">More guides</h2>
        <ul class="mt-4 space-y-3 text-sm">
          {
            otherGuides.map((entry) => (
              <li>
                <a
                  href={`/guides/${entry.slug}/`}
                  class="font-semibold underline decoration-signal-2 decoration-2 underline-offset-4"
                >
                  {entry.title}
                </a>
              </li>
            ))
          }
        </ul>
      </aside>
    </div>
  </div>
</Base>
