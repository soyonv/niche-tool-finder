---
import Base from '../../layouts/Base.astro';
import Breadcrumb from '../../components/Breadcrumb.astro';
import ToolCard from '../../components/ToolCard.astro';
import { tools } from '../../lib/registry';
import { categories } from '../../data/site';
import type { CategoryDef } from '../../data/site';

export function getStaticPaths() {
  return categories.map((category) => ({
    params: { slug: category.slug },
    props: { category },
  }));
}

interface Props {
  category: CategoryDef;
}

const { category } = Astro.props;
const categoryTools = tools.filter((tool) => tool.category === category.slug);
const description = `${category.blurb} ${category.intro[0]}`.slice(0, 155).trim();
---

<Base title={`${category.name} Tools — Free, Private, In-Browser | ScrubKit`} description={description}>
  <div class="container-page pt-8">
    <Breadcrumb items={[{ label: 'Home', href: '/' }, { label: category.name }]} />

    <header class="mt-6 max-w-3xl">
      <span class="eyebrow text-ink-3">Category</span>
      <h1 class="mt-3 text-4xl font-extrabold sm:text-5xl">{category.name}</h1>
      <p class="mt-3 text-lg text-ink-2">{category.blurb}</p>
      <div class="prose-page mt-4">
        {category.intro.map((paragraph) => <p>{paragraph}</p>)}
      </div>
    </header>

    <div class="mt-10 grid gap-5 sm:grid-cols-2 lg:grid-cols-3">
      {
        categoryTools.map((tool) => (
          <ToolCard slug={tool.slug} title={tool.title} tagline={tool.tagline} />
        ))
      }
    </div>

    <div class="mt-14 grid gap-5 border-t border-line pt-10 md:grid-cols-3">
      <div>
        <h2 class="text-xs font-bold uppercase tracking-widest text-ink-3">Other categories</h2>
        <ul class="mt-3 space-y-2 text-sm">
          {
            categories
              .filter((entry) => entry.slug !== category.slug)
              .map((entry) => (
                <li>
                  <a
                    href={`/categories/${entry.slug}/`}
                    class="font-medium underline decoration-signal-2 decoration-2 underline-offset-4"
                  >
                    {entry.name}
                  </a>
                </li>
              ))
          }
        </ul>
      </div>
      <div class="md:col-span-2">
        <h2 class="text-xs font-bold uppercase tracking-widest text-ink-3">
          Need a full workflow?
        </h2>
        <p class="mt-3 text-sm text-ink-2">
          Our use-case guides chain several tools together for real jobs — like
          <a class="font-semibold underline decoration-signal-2 decoration-2 underline-offset-4" href="/use-cases/tidy-a-crm-export/">tidying a messy CRM export</a>
          or<a class="font-semibold underline decoration-signal-2 decoration-2 underline-offset-4" href="/use-cases/dedupe-a-keyword-list/"> deduping a keyword list</a>.
        </p>
      </div>
    </div>
  </div>
</Base>
