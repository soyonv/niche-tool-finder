---
import Base from '../layouts/Base.astro';
import { tools } from '../lib/registry';
---

<Base
  title="Page not found — ScrubKit"
  description="That page does not exist. Pick a text cleaning tool and keep going."
>
  <div class="container-page py-20 text-center">
    <p class="font-mono text-sm font-bold text-ink-3">404</p>
    <h1 class="mt-3 text-4xl font-extrabold sm:text-5xl">This page cleaned itself out.</h1>
    <p class="mx-auto mt-4 max-w-xl text-ink-2">
      The URL you followed does not exist — but the tools do. Start with the
      most-used one, or browse everything.
    </p>
    <div class="mt-8 flex flex-wrap justify-center gap-3">
      <a href="/tools/remove-duplicate-lines/" class="btn btn-primary">Open Remove Duplicate Lines</a>
      <a href="/" class="btn btn-ghost">Back to the homepage</a>
    </div>
    <div class="mx-auto mt-12 max-w-2xl text-left">
      <h2 class="text-xs font-bold uppercase tracking-widest text-ink-3">All tools</h2>
      <ul class="mt-3 flex flex-wrap gap-2">
        {
          tools.map((tool) => (
            <li>
              <a href={`/tools/${tool.slug}/`} class="chip hover:border-ink">
                {tool.title}
              </a>
            </li>
          ))
        }
      </ul>
    </div>
  </div>
</Base>
