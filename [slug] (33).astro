---
import Base from '../../layouts/Base.astro';
import Breadcrumb from '../../components/Breadcrumb.astro';
import ToolCard from '../../components/ToolCard.astro';
import { getTool } from '../../lib/registry';
import { useCases } from '../../data/site';
import type { ToolDefinition } from '../../lib/types';
import type { UseCaseDef } from '../../data/site';

export function getStaticPaths() {
  return useCases.map((useCase) => ({
    params: { slug: useCase.slug },
    props: { useCase },
  }));
}

interface Props {
  useCase: UseCaseDef;
}

const { useCase } = Astro.props;
const linkedTools = useCase.tools
  .map((slug) => getTool(slug))
  .filter((entry): entry is ToolDefinition => Boolean(entry));
const otherUseCases = useCases.filter((entry) => entry.slug !== useCase.slug);
const description = `${useCase.lede}`.slice(0, 155);
---

<Base title={`${useCase.title} — Workflow | ScrubKit`} description={description}>
  <div class="container-page pt-8">
    <Breadcrumb
      items={[
        { label: 'Home', href: '/' },
        { label: 'Use cases', href: '/use-cases/' },
        { label: useCase.title },
      ]}
    />

    <header class="mt-6 max-w-3xl">
      <span class="eyebrow text-ink-3">Use case</span>
      <h1 class="mt-3 text-4xl font-extrabold sm:text-5xl">{useCase.title}</h1>
      <p class="mt-3 text-lg text-ink-2">{useCase.lede}</p>
    </header>

    <div class="mt-12 grid gap-12 lg:grid-cols-3">
      <article class="prose-page lg:col-span-2">
        {
          useCase.sections.map((section) => (
            <section>
              <h2>{section.heading}</h2>
              {section.body.map((paragraph) => (
                <p>{paragraph}</p>
              ))}
            </section>
          ))
        }
      </article>

      <aside>
        <h2 class="text-xs font-bold uppercase tracking-widest text-ink-3">Tools in this workflow</h2>
        <div class="mt-4 space-y-4">
          {
            linkedTools.map((tool) => (
              <ToolCard slug={tool.slug} title={tool.title} tagline={tool.tagline} />
            ))
          }
        </div>

        <h2 class="mt-10 text-xs font-bold uppercase tracking-widest text-ink-3">Other use cases</h2>
        <ul class="mt-4 space-y-3 text-sm">
          {
            otherUseCases.map((entry) => (
              <li>
                <a
                  href={`/use-cases/${entry.slug}/`}
                  class="font-semibold underline decoration-signal-2 decoration-2 underline-offset-4"
                >
                  {entry.title}
                </a>
              </li>
            ))
          }
        </ul>
      </aside>
    </div>
  </div>
</Base>
