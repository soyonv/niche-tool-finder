---
import Base from '../../layouts/Base.astro';
import Breadcrumb from '../../components/Breadcrumb.astro';
import { useCases } from '../../data/site';

const description =
  'Real workflows built on ScrubKit tools: clean a pasted email list, tidy a messy CRM export, and dedupe a keyword list — all without uploading your data.';
---

<Base title="Use Cases — Real Text-Cleaning Workflows | ScrubKit" description={description}>
  <div class="container-page pt-8">
    <Breadcrumb items={[{ label: 'Home', href: '/' }, { label: 'Use cases' }]} />

    <header class="mt-6 max-w-3xl">
      <span class="eyebrow text-ink-3">Workflows</span>
      <h1 class="mt-3 text-4xl font-extrabold sm:text-5xl">Use cases</h1>
      <p class="mt-3 text-lg text-ink-2">
        Real jobs, step by step — each one chains two or more tools together
        and keeps your data on your machine throughout.
      </p>
    </header>

    <div class="mt-10 grid gap-5 md:grid-cols-3">
      {
        useCases.map((useCase) => (
          <a href={`/use-cases/${useCase.slug}/`} class="card block h-full p-6">
            <span class="eyebrow text-ink-3">Use case</span>
            <h2 class="mt-2 text-lg font-bold">{useCase.title}</h2>
            <p class="mt-2 text-sm leading-relaxed text-ink-2">{useCase.lede}</p>
            <span class="mt-4 inline-flex items-center gap-1 text-sm font-semibold">
              Read the workflow <span aria-hidden="true">→</span>
            </span>
          </a>
        ))
      }
    </div>
  </div>
</Base>
