---
import Base from '../../layouts/Base.astro';
import Breadcrumb from '../../components/Breadcrumb.astro';
import ToolCard from '../../components/ToolCard.astro';
import { tools } from '../../lib/registry';
import { categories } from '../../data/site';

const description =
  'Every ScrubKit tool in one place: dedupe lines, remove blank lines, sort, convert case, find and replace, strip extra spaces, make slugs, remove invisible characters, diff text and extract emails.';
---

<Base title="All Text Cleaning Tools — Free & In-Browser | ScrubKit" description={description}>
  <div class="container-page pt-8">
    <Breadcrumb items={[{ label: 'Home', href: '/' }, { label: 'Tools' }]} />

    <header class="mt-6 max-w-3xl">
      <span class="eyebrow text-ink-3">Toolkit</span>
      <h1 class="mt-3 text-4xl font-extrabold sm:text-5xl">All tools</h1>
      <p class="mt-3 text-lg text-ink-2">
        Ten focused tools that run entirely in your browser. Every page is a
        real tool — paste, clean, copy.
      </p>
    </header>

    <div class="mt-10 grid gap-5 sm:grid-cols-2 lg:grid-cols-3">
      {
        tools.map((tool) => (
          <ToolCard
            slug={tool.slug}
            title={tool.title}
            tagline={tool.tagline}
            chip={categories.find((entry) => entry.slug === tool.category)?.name}
          />
        ))
      }
    </div>

    <div class="mt-14 border-t border-line pt-10">
      <h2 class="text-xs font-bold uppercase tracking-widest text-ink-3">Browse by category</h2>
      <div class="mt-4 flex flex-wrap gap-2">
        {
          categories.map((category) => (
            <a href={`/categories/${category.slug}/`} class="chip hover:border-ink">
              {category.name}
            </a>
          ))
        }
      </div>
    </div>
  </div>
</Base>
