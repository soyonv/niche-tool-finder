---
interface Crumb {
  label: string;
  href?: string;
}

interface Props {
  items: Crumb[];
}

const { items } = Astro.props;
---

<nav aria-label="Breadcrumb" class="text-xs text-ink-3">
  <ol class="flex flex-wrap items-center gap-1.5">
    {
      items.map((item, index) => (
        <li class="flex items-center gap-1.5">
          {item.href ? (
            <a href={item.href} class="hover:text-ink hover:underline underline-offset-2">
              {item.label}
            </a>
          ) : (
            <span aria-current="page" class="font-medium text-ink">
              {item.label}
            </span>
          )}
          {index < items.length - 1 && <span aria-hidden="true">/</span>}
        </li>
      ))
    }
  </ol>
</nav>
