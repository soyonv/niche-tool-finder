---
import Base from '../../layouts/Base.astro';
import Breadcrumb from '../../components/Breadcrumb.astro';
import { guides } from '../../data/site';

const description =
  'Practical guides to cleaning text properly: deduplicating lists without Excel, and finding the invisible characters that break your data.';
---

<Base title="Guides — How to Clean Text Properly | ScrubKit" description={description}>
  <div class="container-page pt-8">
    <Breadcrumb items={[{ label: 'Home', href: '/' }, { label: 'Guides' }]} />

    <header class="mt-6 max-w-3xl">
      <span class="eyebrow text-ink-3">Learn</span>
      <h1 class="mt-3 text-4xl font-extrabold sm:text-5xl">Guides</h1>
      <p class="mt-3 text-lg text-ink-2">
        Short, practical writing about doing text cleanup properly — when a
        browser tool is enough, and when it is not.
      </p>
    </header>

    <div class="mt-10 grid gap-5 md:grid-cols-2">
      {
        guides.map((guide) => (
          <a href={`/guides/${guide.slug}/`} class="card block h-full p-6">
            <span class="eyebrow text-ink-3">Guide</span>
            <h2 class="mt-2 text-lg font-bold">{guide.title}</h2>
            <p class="mt-2 text-sm leading-relaxed text-ink-2">{guide.lede}</p>
            <span class="mt-4 inline-flex items-center gap-1 text-sm font-semibold">
              Read the guide <span aria-hidden="true">→</span>
            </span>
          </a>
        ))
      }
    </div>
  </div>
</Base>
