---
import '../styles/global.css';
import { tools } from '../lib/registry';
import { categories, guides, useCases } from '../data/site';

interface Props {
  title: string;
  description: string;
  ogType?: string;
}

const { title, description, ogType = 'website' } = Astro.props;
const canonical = new URL(Astro.url.pathname, Astro.site ?? 'https://scrubkit.workers.dev');
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={canonical.toString()} />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <meta property="og:type" content={ogType} />
    <meta property="og:site_name" content="ScrubKit" />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical.toString()} />
    <meta name="twitter:card" content="summary" />
    <meta name="generator" content={Astro.generator} />
  </head>
  <body class="flex min-h-screen flex-col">
    <header class="sticky top-0 z-40 border-b border-line bg-paper/90 backdrop-blur">
      <div class="container-page flex h-16 items-center justify-between gap-4">
        <a
          href="/"
          class="flex items-center gap-2 text-lg font-extrabold tracking-tight"
        >
          <span
            class="grid size-7 place-items-center rounded-md bg-ink text-sm font-black text-signal"
            aria-hidden="true"
          >
            S
          </span>
          ScrubKit
        </a>
        <nav class="hidden items-center gap-5 text-sm font-medium text-ink-2 md:flex" aria-label="Primary">
          <a href="/#tools" class="hover:text-ink">Tools</a>
          <a href="/use-cases/" class="hover:text-ink">Use cases</a>
          <a href="/guides/" class="hover:text-ink">Guides</a>
          <a href="/privacy/" class="hover:text-ink">Privacy</a>
        </nav>
        <a href="/tools/remove-duplicate-lines/" class="btn btn-primary">Open a tool</a>
      </div>
    </header>

    <main class="flex-1">
      <slot />
    </main>

    <footer class="mt-20 bg-deep text-paper">
      <div class="container-page grid gap-10 py-14 md:grid-cols-4">
        <div>
          <div class="flex items-center gap-2 text-lg font-extrabold">
            <span
              class="grid size-7 place-items-center rounded-md bg-signal text-sm font-black text-ink"
              aria-hidden="true"
            >
              S
            </span>
            ScrubKit
          </div>
          <p class="mt-3 text-sm leading-relaxed text-paper/70">
            No upload. No signup. No limits. Clean your data instantly in your
            browser.
          </p>
          <div class="mt-4 flex flex-wrap gap-2">
            <span class="chip chip-dark">100% client-side</span>
            <span class="chip chip-dark">Free forever</span>
          </div>
        </div>

        <nav aria-label="Tools">
          <h2 class="text-xs font-bold uppercase tracking-widest text-signal">Tools</h2>
          <ul class="mt-3 space-y-2 text-sm">
            {
              tools.map((tool) => (
                <li>
                  <a href={`/tools/${tool.slug}/`} class="text-paper/70 hover:text-signal">
                    {tool.title}
                  </a>
                </li>
              ))
            }
          </ul>
        </nav>

        <nav aria-label="Categories">
          <h2 class="text-xs font-bold uppercase tracking-widest text-signal">Categories</h2>
          <ul class="mt-3 space-y-2 text-sm">
            {
              categories.map((category) => (
                <li>
                  <a
                    href={`/categories/${category.slug}/`}
                    class="text-paper/70 hover:text-signal"
                  >
                    {category.name}
                  </a>
                </li>
              ))
            }
          </ul>
        </nav>

        <nav aria-label="Learn">
          <h2 class="text-xs font-bold uppercase tracking-widest text-signal">Learn</h2>
          <ul class="mt-3 space-y-2 text-sm">
            {
              useCases.map((useCase) => (
                <li>
                  <a href={`/use-cases/${useCase.slug}/`} class="text-paper/70 hover:text-signal">
                    {useCase.title}
                  </a>
                </li>
              ))
            }
            {
              guides.map((guide) => (
                <li>
                  <a href={`/guides/${guide.slug}/`} class="text-paper/70 hover:text-signal">
                    {guide.title}
                  </a>
                </li>
              ))
            }
            <li><a href="/privacy/" class="text-paper/70 hover:text-signal">Privacy</a></li>
            <li><a href="/about/" class="text-paper/70 hover:text-signal">About</a></li>
          </ul>
        </nav>
      </div>
      <div class="border-t border-deep-3">
        <div class="container-page flex flex-col gap-2 py-5 text-xs text-paper/50 sm:flex-row sm:justify-between">
          <span>© 2026 ScrubKit — every tool runs in your browser.</span>
          <span>No uploads · No accounts · No tracking</span>
        </div>
      </div>
    </footer>
  </body>
</html>
