---
interface Props {
  slug: string;
  title: string;
  tagline: string;
  chip?: string;
}

const { slug, title, tagline, chip } = Astro.props;
---

<a href={`/tools/${slug}/`} class="card block h-full p-5">
  <div class="flex items-start justify-between gap-3">
    <h3 class="text-lg font-bold leading-tight">{title}</h3>
    {chip && <span class="chip shrink-0">{chip}</span>}
  </div>
  <p class="mt-2 text-sm leading-relaxed text-ink-2">{tagline}</p>
  <span class="mt-4 inline-flex items-center gap-1 text-sm font-semibold text-ink">
    Open tool
    <span aria-hidden="true">→</span>
  </span>
</a>
